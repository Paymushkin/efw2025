{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "update-runways-data": "tsx scripts/updateDesignerRunwaysData.ts",
    "preview": "node .output/server/index.mjs",
    "preview:static": "npx --yes serve@14 .output/public",
    "preview:fresh": "lsof -ti:3000 | xargs kill -9 2>/dev/null || true && rm -rf .output .nuxt && npm run build && npm run preview",
    "postinstall": "nuxt prepare",
    "deploy": "npm run generate && gh-pages -d .output/public",
    "lint": "eslint --ext .js,.vue .",
    "format": "prettier --write .",
    "netlify-dev": "npx --yes netlify-cli dev"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@fancyapps/fancybox": "^3.5.7",
    "@headlessui/vue": "^1.7.23",
    "@nuxt/image": "^1.10.0",
    "@sendgrid/mail": "^8.1.4",
    "gsap": "^3.12.7",
    "jquery": "^3.7.1",
    "lite-youtube-embed": "^0.3.4",
    "nodemailer": "^6.9.9",
    "nuxt": "^3.15.4",
    "resend": "^4.1.2",
    "swiper": "^11.2.4",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nuxtjs/sitemap": "^6.1.5",
    "@nuxtjs/tailwindcss": "^6.10.0",
    "@tailwindcss/postcss7-compat": "^2.2.17",
    "@types/nodemailer": "^6.4.17",
    "@vercel/node": "^5.1.14",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-vue": "^9.33.0",
    "gh-pages": "^6.3.0",
    "postcss-import": "^16.1.0",
    "prettier": "^3.5.1",
    "tsx": "^4.19.2"
  },
  "homepage": "https://pamushkin.github.io/dubaifw"
}
